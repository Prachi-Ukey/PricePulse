# PricePulse Environment Configuration
# Default backend settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (SQLite by default; supports postgresql+psycopg2://... for PostgreSQL)
DATABASE_URL=sqlite:///./pricepulse.db

# Synthetic seed settings
AUTO_SEED_ON_STARTUP=true
SEED_PRODUCT_COUNT=100
SEED_TRANSACTION_COUNT=5000

# Frontend environment (can be mirrored in frontend/.env)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
